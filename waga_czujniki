// --- Nowe piny tensometru (zwolnione GPIO 21/22 dla I2C) ---
const int DOUT_PIN = 16;
const int SCK_PIN  = 17;

// --- Czujnik mętności (wyjście analogowe przez dzielnik napięcia -> max 3.3V) ---
const int TURBIDITY_PIN = 36;

// --- Czujnik koloru RGB TCS34725 (I2C 0x29) ---
Adafruit_TCS34725 tcs = Adafruit_TCS34725(TCS34725_INTEGRATIONTIME_154MS, TCS34725_GAIN_4X);
bool g_tcsReady = false;

// Struktura wyników analizy optycznej dializatu
struct DialysateOptics {
  bool valid;
  uint16_t r;
  uint16_t g;
  uint16_t b;
  uint16_t c;           // Kanał jasności (Clear)
  float redGreenRatio;  // Wskaźnik hemoperitoneum (R / G)
  float turbidityVolt;  // Napięcie po uśrednieniu (wyższe = czystszy płyn)
  float clarityPct;     // Szacowana przejrzystość (0–100%)
  String statusLabel;   // "CLEAR", "CLOUDY", "BLOOD_TRACE"
};

DialysateOptics measureDialysateOptics() {
  DialysateOptics res = { false, 0, 0, 0, 0, 0.0f, 0.0f, 0.0f, "UNKNOWN" };

  // 1. Odczyt mętności (15 próbek z odrzuceniem zakłóceń)
  long adcSum = 0;
  for (int i = 0; i < 15; i++) {
    adcSum += analogRead(TURBIDITY_PIN);
    delay(10);
  }
  float avgAdc = adcSum / 15.0f;
  // Przeliczenie 12-bit ADC ESP32 (0-4095) na napięcie (0-3.3V)
  res.turbidityVolt = (avgAdc / 4095.0f) * 3.3f;

  // Skalowanie przejrzystości: skalibruj V_CLEAR (np. 2.85V dla czystego worka w szczelinie)
  // oraz V_CLOUDY (np. 1.20V dla silnego zmętnienia) na swoim stanowisku
  const float V_CLEAR  = 2.85f;
  const float V_CLOUDY = 1.20f;
  float pct = ((res.turbidityVolt - V_CLOUDY) / (V_CLEAR - V_CLOUDY)) * 100.0f;
  res.clarityPct = constrain(pct, 0.0f, 100.0f);

  // 2. Odczyt koloru RGB z TCS34725
  if (g_tcsReady) {
    tcs.setInterrupt(false); // Włącz białą diodę LED na płytce TCS34725
    delay(200);              // Czas na pełną integrację przetwornika (154 ms + zapas)

    uint32_t sumR = 0, sumG = 0, sumB = 0, sumC = 0;
    const int samples = 4;
    for (int i = 0; i < samples; i++) {
      uint16_t r, g, b, c;
      tcs.getRawData(&r, &g, &b, &c);
      sumR += r;
      sumG += g;
      sumB += b;
      sumC += c;
      delay(160);
    }

    tcs.setInterrupt(true);  // Wyłącz diodę LED po pomiarze

    res.r = sumR / samples;
    res.g = sumG / samples;
    res.b = sumB / samples;
    res.c = sumC / samples;
    res.redGreenRatio = (res.g > 0) ? ((float)res.r / (float)res.g) : 0.0f;
    res.valid = true;
  }

  // 3. Klasyfikacja stanu płynu (progi do dostrojenia na własnym worku)
  // Dla czystego słomkowego dializatu R/G wynosi zwykle ~1.05 - 1.25.
  // Domieszka krwi podnosi R/G powyżej ~1.45.
  if (res.valid && res.redGreenRatio > 1.45f) {
    res.statusLabel = "BLOOD_TRACE";
  } else if (res.clarityPct < 75.0f) {
    res.statusLabel = "CLOUDY";
  } else {
    res.statusLabel = "CLEAR";
  }

  return res;
}
