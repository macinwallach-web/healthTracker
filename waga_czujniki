bool sendRecordToFirestore(
  const String& eventType,
  float weightKg,
  float ufKg,
  unsigned long durationSec,
  float flowRateGPerMin,
  const DialysateOptics& optics
) {
  if (!ensureWiFiConnected() || !ensureValidIdToken()) return false;

  WiFiClientSecure client;
  client.setInsecure();

  String url = "https://firestore.googleapis.com/v1/projects/" + String(PROJECT_ID) +
               "/databases/(default)/documents/" + String(COLLECTION);

  HTTPClient http;
  http.begin(client, url);
  http.addHeader("Content-Type", "application/json");
  http.addHeader("Authorization", "Bearer " + g_idToken);

  String isoTime = getIsoTimestampUTC();

  String payload = "{\"fields\": {";
  payload += "\"event_type\": {\"stringValue\": \"" + eventType + "\"},";
  payload += "\"weight_kg\": {\"doubleValue\": " + String(weightKg, 3) + "},";
  payload += "\"weight_g\": {\"integerValue\": \"" + String((int)round(weightKg * 1000.0f)) + "\"}";

  if (eventType == "drain") {
    payload += ",\"drain_duration_sec\": {\"integerValue\": \"" + String(durationSec) + "\"}";
    payload += ",\"flow_rate_g_min\": {\"doubleValue\": " + String(flowRateGPerMin, 1) + "}";
    if (g_hasPrevFresh) {
      payload += ",\"prev_fresh_kg\": {\"doubleValue\": " + String(g_prevFreshWeightKg, 3) + "}";
      payload += ",\"uf_kg\": {\"doubleValue\": " + String(ufKg, 3) + "}";
      payload += ",\"uf_ml\": {\"integerValue\": \"" + String((int)round(ufKg * 1000.0f)) + "\"}";
    }

    // Dane optyczne (mętność + kolor RGB)
    payload += ",\"turbidity_v\": {\"doubleValue\": " + String(optics.turbidityVolt, 3) + "}";
    payload += ",\"clarity_pct\": {\"doubleValue\": " + String(optics.clarityPct, 1) + "}";
    payload += ",\"fluid_status\": {\"stringValue\": \"" + optics.statusLabel + "\"}";

    if (optics.valid) {
      payload += ",\"color_r\": {\"integerValue\": \"" + String(optics.r) + "\"}";
      payload += ",\"color_g\": {\"integerValue\": \"" + String(optics.g) + "\"}";
      payload += ",\"color_b\": {\"integerValue\": \"" + String(optics.b) + "\"}";
      payload += ",\"color_c\": {\"integerValue\": \"" + String(optics.c) + "\"}";
      payload += ",\"red_green_ratio\": {\"doubleValue\": " + String(optics.redGreenRatio, 3) + "}";
    }
  }

  if (isoTime.length() > 0) {
    payload += ",\"recorded_at\": {\"timestampValue\": \"" + isoTime + "\"}";
  }
  payload += "}}";

  int httpCode = http.POST(payload);
  http.end();

  if (httpCode == 401 || httpCode == 403) g_idToken = "";
  return (httpCode >= 200 && httpCode < 300);
}

if (postStableMs >= 5000) {
  g_drainDurationSec = elapsedSec;
  float finalFlowRate = (g_drainDurationSec > 0) ? ((drainedMassKg * 1000.0f) / (g_drainDurationSec / 60.0f)) : 0.0f;

  float ufKg = 0.0f;
  if (g_hasPrevFresh) {
    ufKg = drainedMassKg - g_prevFreshWeightKg;
  }

  // Pomiar optyczny (mętność + kolor RGB) na ustabilizowanym worku
  M5.Lcd.fillScreen(BLACK);
  M5.Lcd.setTextColor(CYAN, BLACK);
  M5.Lcd.setTextSize(2);
  M5.Lcd.drawCentreString("Analiza optyczna plynu...", 160, 105, 1);

  DialysateOptics optics = measureDialysateOptics();

  // Wyświetlenie podsumowania UF oraz statusu klarowności/barwy
  M5.Lcd.fillScreen(BLACK);
  M5.Lcd.setTextColor(YELLOW, BLACK);
  M5.Lcd.setTextSize(3);
  M5.Lcd.drawCentreString("Zapis drenazu...", 160, 55, 1);

  if (g_hasPrevFresh) {
    char ufBuf[32];
    sprintf(ufBuf, "UF: %+.0f ml", ufKg * 1000.0f);
    M5.Lcd.drawCentreString(ufBuf, 160, 95, 1);
  }

  M5.Lcd.setTextSize(2);
  char optBuf[40];
  sprintf(optBuf, "Klarownosc: %.0f%% | R/G: %.2f", optics.clarityPct, optics.redGreenRatio);
  M5.Lcd.drawCentreString(optBuf, 160, 135, 1);

  if (optics.statusLabel != "CLEAR") {
    M5.Lcd.setTextColor(RED, BLACK);
    M5.Lcd.drawCentreString("ALERT: SPRAWDZ PLYN!", 160, 165, 1);
  }

  bool ok = sendRecordToFirestore("drain", drainedMassKg, ufKg, g_drainDurationSec, finalFlowRate, optics);

  // Alarm dźwiękowy jeśli wykryto zmętnienie lub podbarwienie krwią
  if (optics.statusLabel != "CLEAR") {
    playBeep(2200, 300, 4);
  } else {
    playBeep(1500, 200, ok ? 2 : 3);
  }

  if (prefs.getBool("has_next", false)) {
    g_prevFreshWeightKg = prefs.getFloat("next_fresh", 0.0f);
    g_hasPrevFresh = true;
    prefs.putFloat("prev_fresh", g_prevFreshWeightKg);
    prefs.putBool("has_prev", true);
  }

  g_flushStartWeightKg = weightKg;
  resetStabilityTracker();
  M5.Lcd.fillScreen(BLACK);
  g_state = STATE_FLUSHING;
  break;
}
